# Copy to .env and adjust if needed. Default values target LocalStack on localhost.
# NEVER point at real AWS endpoints with this file — the dummy credentials below
# would be rejected by AWS but ACCEPTED by LocalStack. That's the whole point.

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# Terraform reads these too (via the AWS provider's `endpoints` block in provider.tf).
TF_VAR_localstack_endpoint=http://localhost:4566
